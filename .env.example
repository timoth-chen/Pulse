# Keep your actual key in .env (git-ignored), never in browser code or chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional native Windows paths. Docker already includes these local readers.
# Use your installation paths; forward slashes also work on Windows.
# PULSE_PDFINFO="C:/Tools/poppler/Library/bin/pdfinfo.exe"
# PULSE_PDFTOTEXT="C:/Tools/poppler/Library/bin/pdftotext.exe"
# PULSE_PDFTOPPM="C:/Tools/poppler/Library/bin/pdftoppm.exe"
# PULSE_TESSERACT="C:/Program Files/Tesseract-OCR/tesseract.exe"

# Optional daily stock/ETF quotes. Keep the key server-side only.
ALPHAVANTAGE_API_KEY=

# Set true behind an HTTPS reverse proxy; keep false/unset for local HTTP testing.
PULSE_SECURE_COOKIES=false

# Optional Canadian car valuations. Provider plan/credits may be required.
MARKETCHECK_API_KEY=

# Optional Canadian comparable vehicle quotes (free allowance; key stays on server)
CARDOG_API_KEY=
