{
  "dependencies": {
    "express": "^4.19.2",
    "fast-xml-parser": "^5.12.1"
  },
  "description": "Self-hostable household finance dashboard for two people. Imports bank CSV exports, tracks spending and explains your pay. Your data stays on your server.",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "main": "server.js",
  "name": "household-finance-app",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:backup": "node scripts/backup-db.js",
    "test": "node --test tests/*.test.js",
    "imports:check": "node scripts/check-import-tools.js"
  },
  "type": "commonjs",
  "version": "3.3.0"
}
